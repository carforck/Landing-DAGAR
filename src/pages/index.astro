---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Skills from "../components/sections/Skills.astro";
import Stats from "../components/sections/Stats.astro";
import Clients from "../components/sections/Clients.astro";
import Services from "../components/sections/Services.astro";
import Gallery from "../components/sections/Gallery.astro";
import Portfolio from "../components/sections/Portfolio.astro";
import Products from "../components/sections/Products.astro";
import Faq from "../components/sections/Faq.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="DAGAR - Soluciones Inteligentes"
    description="Ingeniería y mantenimiento especializada en climatización. Distribuidor autorizado de equipos Midea, McQuay, LG y Panasonic."
>
    <Header />

    <main class="main">
        <Hero />
        <About />
        <Skills />
        <Services />
        <Portfolio />
        <Stats />
        <Clients />
        <Gallery />
        <Faq />
        <Products />
        <Contact />
    </main>

    <Footer />
</Layout>
