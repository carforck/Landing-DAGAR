<!-- About Section -->
<section id="about" class="about section light-background">
    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Nosotros</h2>
        <p>
            <span class="description-title">Acerca</span>
            <span>de nosotros</span>
        </p>
    </div><!-- End Section Title -->

    <div class="container">
        <div class="row gy-3">
            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                <img src="/img/DAGAR-colombia-2025.png" alt="" class="img-fluid" />
            </div>

            <div
                class="col-lg-6 d-flex flex-column justify-content-center"
                data-aos="fade-up"
                data-aos-delay="200"
            >
                <div class="about-content ps-0 ps-lg-3">
                    <p>
                        Somos una empresa de <strong
                            >ingeniería y mantenimiento especializada en
                            climatización y obra civil.</strong
                        > Nuestro equipo está conformado por profesionales y técnicos,
                        con más de <strong>15 años de experiencia</strong> laborando
                        con disciplina y responsabilidad. Trabajamos en tu requerimiento
                        de forma continua, las <strong
                            >24 horas del día, los 7 días de la semana</strong
                        > para entregarte soluciones inteligentes y eficientes. Llevamos
                        nuestros servicios a todos los municipios de <strong
                            >La Guajira, Magdalena, Atlántico, Bolívar, Sucre,
                            Córdoba y Cesar.</strong
                        >
                    </p>
                </div>
            </div>
        </div>
    </div>
</section><!-- /About Section -->
