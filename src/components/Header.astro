---
// Header.astro
---

<header id="header" class="header sticky-top">
    <div class="topbar d-flex align-items-center">
        <div class="container d-flex justify-content-center justify-content-md-between">
            <div class="contact-info d-flex align-items-center">
                <i class="bi bi-envelope d-flex align-items-center">
                    <a href="mailto:info@dagarsoluciones.com.co">
                        info@dagarsoluciones.com.co
                    </a>
                </i>
                <i class="bi bi-phone d-flex align-items-center ms-4">
                    <span>+57 316 356 7690</span>
                </i>
            </div>
            <div class="social-links d-none d-md-flex align-items-center">
                <a href="https://www.facebook.com" class="facebook">
                    <i class="bi bi-facebook"></i>
                </a>
                <a
                    href="https://www.instagram.com/dagarsoluciones_sas"
                    class="instagram"
                >
                    <i class="bi bi-instagram"></i>
                </a>
                <a href="https://www.linkedin.com" class="linkedin">
                    <i class="bi bi-linkedin"></i>
                </a>
            </div>
        </div>
    </div>
    <!-- End Top Bar -->

    <div class="branding d-flex align-items-cente">
        <div class="container position-relative d-flex align-items-center justify-content-between">
            <a href="index.html" class="logo d-flex align-items-center">
                <h1 class="d-flex align-items-center sitename visually-hidden-text">
                    <img
                        src="/img/dagar-logo.svg"
                        alt="Dagar Logo"
                        class="img-fluid logotipo"
                        width="auto"
                        height="auto"
                    />
                    <span class="visually-hidden-text">
                        Dagar Soluciones Inteligentes
                    </span>
                </h1>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    <li>
                        <a href="#about" class="active">
                            Nosotros
                        </a>
                    </li>
                    <li>
                        <a href="#services">Servicios</a>
                    </li>
                    <li>
                        <a href="#portfolio">Portafolio</a>
                    </li>
                    <li>
                        <a href="#faq">F.A.Q</a>
                    </li>
                    <li>
                        <a
                            target="_blank"
                            href="POL-EST-001_Politica_de_Calidad.pdf"
                        >
                            Politica
                        </a>
                    </li>
                    <li>
                        <a class="contact" href="#contact">
                            Contacto
                        </a>
                    </li>
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>
        </div>
    </div>
</header>
